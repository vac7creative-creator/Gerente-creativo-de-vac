{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Un proyecto o pedido de diseño de V.A.C. Creative Studio",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único del proyecto"
        },
        "clientName": {
          "type": "string",
          "description": "Nombre completo del cliente"
        },
        "clientPhone": {
          "type": "string",
          "description": "Número de teléfono"
        },
        "clientEmail": {
          "type": "string",
          "description": "Correo electrónico"
        },
        "type": {
          "type": "string",
          "description": "Tipo de servicio"
        },
        "status": {
          "type": "string",
          "description": "Estado del flujo de trabajo"
        },
        "trackingCode": {
          "type": "string",
          "description": "Código privado de seguimiento VAC-XXXX..."
        },
        "driveFolderId": {
          "type": "string",
          "description": "ID de la carpeta del proyecto en Google Drive"
        },
        "driveFolderUrl": {
          "type": "string",
          "description": "Enlace web directo a la carpeta en Google Drive"
        },
        "driveUploadsFolderId": {
          "type": "string",
          "description": "ID de la subcarpeta de archivos del cliente en Google Drive"
        },
        "driveReferencesFolderId": {
          "type": "string",
          "description": "ID de la subcarpeta de referencias en Google Drive"
        },
        "driveFinalFilesFolderId": {
          "type": "string",
          "description": "ID de la subcarpeta de entregables finales en Google Drive"
        },
        "createdAt": {
          "type": "string",
          "description": "Fecha de creación"
        },
        "updatedAt": {
          "type": "string",
          "description": "Fecha de actualización"
        }
      },
      "required": ["id", "clientName", "type", "status", "createdAt", "updatedAt"]
    },
    "TrackingItem": {
      "title": "TrackingItem",
      "description": "Información pública mínima de seguimiento para clientes por código privado",
      "type": "object",
      "properties": {
        "trackingCode": {
          "type": "string",
          "description": "Código secreto VAC-XXXX..."
        },
        "projectId": {
          "type": "string",
          "description": "ID del proyecto asociado"
        },
        "serviceType": {
          "type": "string",
          "description": "Tipo de servicio"
        },
        "status": {
          "type": "string",
          "description": "Estado del proyecto"
        },
        "createdAt": {
          "type": "string",
          "description": "Fecha de creación"
        },
        "updatedAt": {
          "type": "string",
          "description": "Fecha de actualización"
        },
        "publicMessage": {
          "type": "string",
          "description": "Mensaje público opcional"
        }
      },
      "required": ["trackingCode", "projectId", "serviceType", "status", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de usuario y roles de acceso (RBAC)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["uid", "role", "email"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Colección privada de proyectos"
    },
    "/tracking/{trackingCode}": {
      "schema": "TrackingItem",
      "description": "Colección pública de seguimiento mediante código privado"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Roles de autorización administrativa"
    }
  }
}
