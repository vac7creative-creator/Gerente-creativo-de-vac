rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidTrackingCode(code) {
      return code is string 
        && code.size() == 29 
        && code.matches('^VAC-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128
        && data.clientName is string && data.clientName.size() <= 200
        && data.type is string && data.type.size() <= 100
        && data.status is string && data.status.size() <= 50;
    }

    function isValidPublicTrackingCreate() {
      return incoming().keys().hasOnly(['trackingCode', 'projectId', 'serviceType', 'status', 'createdAt', 'updatedAt', 'publicMessage'])
        && incoming().trackingCode is string
        && isValidTrackingCode(incoming().trackingCode)
        && incoming().trackingCode == request.resource.id
        && incoming().projectId is string && incoming().projectId.size() <= 128
        && incoming().serviceType is string && incoming().serviceType.size() <= 100
        && incoming().status == "Pendiente"
        && incoming().createdAt is string
        && incoming().updatedAt is string;
    }

    // Projects collection: Private for admin, public create only
    match /projects/{projectId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isValidId(projectId)
                    && isValidProject(incoming())
                    && (isAdmin() || incoming().status == "Pendiente");
    }

    // Tracking collection: Public get by exact secure tracking code, no listing, strict creation rules
    match /tracking/{trackingCode} {
      allow get: if isValidTrackingCode(trackingCode);
      allow list: if false;
      allow create: if isAdmin() || isValidPublicTrackingCreate();
      allow update, delete: if isAdmin();
    }

    // Users collection for RBAC authorization
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Health check test doc: Read only
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
