rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidTrackingCode(code) {
      return code is string 
        && code.size() == 33 
        && code.matches('^VAC-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128
        && data.clientName is string && data.clientName.size() <= 200
        && data.type is string && data.type.size() <= 100
        && data.status is string && data.status.size() <= 50;
    }

    function isValidPublicTrackingCreate() {
      return incoming().keys().hasOnly(['trackingCode', 'projectId', 'serviceType', 'status', 'createdAt', 'updatedAt', 'publicMessage'])
        && incoming().trackingCode is string
        && isValidTrackingCode(incoming().trackingCode)
        && incoming().trackingCode == request.resource.id
        && incoming().projectId is string && incoming().projectId.size() <= 128
        && incoming().serviceType is string && incoming().serviceType.size() <= 100
        && incoming().status == "Pendiente"
        && incoming().createdAt is string
        && incoming().updatedAt is string;
    }

    function isValidPublicProjectUpdate(projectId) {
      return isValidId(projectId)
        && isValidProject(incoming())
        // El documento debe pertenecer al mismo ID y estar en estado Pendiente
        && resource.data.id == projectId
        && incoming().id == projectId
        && resource.data.status == "Pendiente"
        && incoming().status == "Pendiente"
        // Inmutabilidad de identidad: no alterar trackingCode, cliente, tipo ni creación original
        && (!('trackingCode' in resource.data) || incoming().trackingCode == resource.data.trackingCode)
        && (!('clientName' in resource.data) || incoming().clientName == resource.data.clientName)
        && (!('type' in resource.data) || incoming().type == resource.data.type)
        && (!('createdAt' in resource.data) || incoming().createdAt == resource.data.createdAt)
        && incoming().updatedAt is string
        // Restricción estricta: la actualización pública solo puede modificar campos de subida a Drive y updatedAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uploadedFiles',
          'googleDriveUrl',
          'driveFolderId',
          'driveFolderUrl',
          'driveUploadsFolderId',
          'driveReferencesFolderId',
          'driveFinalFilesFolderId',
          'driveStatus',
          'updatedAt'
        ]);
    }

    function isValidPublicTrackingUpdate(code) {
      return incoming().keys().hasOnly(['trackingCode', 'projectId', 'serviceType', 'status', 'createdAt', 'updatedAt', 'publicMessage'])
        && incoming().trackingCode is string
        && incoming().trackingCode == code
        && incoming().trackingCode == resource.data.trackingCode
        && incoming().projectId == resource.data.projectId
        && incoming().serviceType == resource.data.serviceType
        && resource.data.status == "Pendiente"
        && incoming().status == "Pendiente"
        && incoming().createdAt == resource.data.createdAt
        && incoming().updatedAt is string;
    }

    // Projects collection: Private for admin, public create & safe public completion update
    match /projects/{projectId} {
      allow get, list, delete: if isAdmin();
      allow create: if isValidId(projectId)
                    && isValidProject(incoming())
                    && (isAdmin() || incoming().status == "Pendiente");
      allow update: if isAdmin() || isValidPublicProjectUpdate(projectId);
    }

    // Tracking collection: Public get by exact secure tracking code, no listing, strict creation & update rules
    match /tracking/{trackingCode} {
      allow get: if isValidTrackingCode(trackingCode);
      allow list: if false;
      allow create: if isAdmin() || isValidPublicTrackingCreate();
      allow update: if isAdmin() || isValidPublicTrackingUpdate(trackingCode);
      allow delete: if isAdmin();
    }

    // Users collection for RBAC authorization
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Health check test doc: Read only
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
