rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Role check: verifies the user document in /users exists and has role == 'admin'
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128
        && data.clientName is string && data.clientName.size() <= 200
        && data.type is string && data.type.size() <= 100
        && data.status is string && data.status.size() <= 50;
    }

    // Projects collection:
    // ADMIN: full get, list, create, update, delete
    // PUBLIC: ONLY create a new project with initial status "Pendiente"
    match /projects/{projectId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isValidId(projectId)
                    && isValidProject(incoming())
                    && (isAdmin() || incoming().status == "Pendiente");
    }

    // Users collection for authorization & RBAC:
    // READ: Only the signed-in user themselves or an admin
    // WRITE (create, update, delete): ONLY existing verified admin (no self-promotion)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Health check test doc: READ only, NO public write
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
